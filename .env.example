# Mission Cosmos — variables d'environnement
# Copier vers .env.local et adapter si besoin.
# Dev ↔ prod : ne modifier que ce fichier (ou .env.local), pas le code.

# Environnement d'exécution : development | production
NEXT_PUBLIC_APP_ENV=development

# URL publique de l'app (sans slash final)
NEXT_PUBLIC_APP_URL=http://localhost:3000
