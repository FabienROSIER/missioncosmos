# Mission Cosmos — variables d'environnement
# Copier vers .env.local et adapter si besoin.
# Dev ↔ prod : ne modifier que ce fichier (ou .env.local), pas le code.

# Environnement d'exécution : development | production
NEXT_PUBLIC_APP_ENV=development

# URL publique de l'app (sans slash final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sous-chemin de déploiement (vide en local).
# GitHub Pages (dépôt missioncosmos) : /missioncosmos
# Laissé vide → chemins à la racine (next dev / build local).
# NEXT_PUBLIC_BASE_PATH=

# Identifiant de build PWA (cache shell). Le workflow CI injecte le SHA.
# NEXT_PUBLIC_BUILD_ID=
